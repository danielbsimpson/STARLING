# ─────────────────────────────────────────────────────────────────────────────
# .env.example — S.T.A.R.L.I.N.G. environment variables
#
# Copy this file to .env and edit the values for your setup.
#   cp .env.example .env
#
# Variables marked (required) must be set for the relevant backend to work.
# Variables marked (optional) have sensible defaults and can be left as-is.
# ─────────────────────────────────────────────────────────────────────────────


# ── LLM backend selection ─────────────────────────────────────────────────────
# Controls which LLM relay is loaded at startup. Both expose /chat/ with the
# same NDJSON streaming format — no frontend changes are needed when switching.
#
# "llama"  → backend/llama_server.py — talks directly to llama-server (llama.cpp)
#            Faster first-token latency; recommended for local GPU setups.
#            Requires: scripts/start_llama_server.bat to be running.
# "ollama" → backend/ollama.py — talks to Ollama's /api/chat endpoint.
#            Easier setup; Ollama manages the model process automatically.
#
LLM_BACKEND=llama


# ── llama-server / llama.cpp ──────────────────────────────────────────────────
# Used when LLM_BACKEND=llama.
#
# To start llama-server:
#   Windows:  scripts\start_llama_server.bat
#   Linux:    llama-server --model <path> --alias <name> --n-gpu-layers 999 --ctx-size 4096 --port 8080
#
# Download llama-server binaries:
#   https://github.com/ggml-org/llama.cpp/releases  (llama-*-win-cuda-cu12.x.x-x64.zip)
#
# (required) URL where llama-server is listening.
LLAMA_SERVER_URL=http://localhost:8080

# (required) Model alias — must match the --alias flag passed to llama-server.
LLAMA_MODEL=llama3.2-3b

# (optional) Sampling temperature. 0.0 = deterministic, 1.0 = creative.
LLAMA_TEMPERATURE=0.7

# (optional) System prompt injected at the start of every conversation.
LLAMA_SYSTEM_PROMPT=You are S.T.A.R.L.I.N.G. (Speech‑Triggered Autonomous Reasoning & Local Intelligence Node Generator), a highly capable local AI assistant. Be concise, precise, and direct. Avoid unnecessary pleasantries.


# ── Ollama ────────────────────────────────────────────────────────────────────
# Used when LLM_BACKEND=ollama. Ollama must be running and have the model pulled.
#   Install: https://ollama.com
#   Pull:    ollama pull llama3.2:3b
#
# (required) Base URL for the Ollama HTTP API.
OLLAMA_BASE_URL=http://localhost:11434

# (required) Model tag as shown in `ollama list`.
OLLAMA_MODEL=llama3.2:3b

# (optional) Sampling temperature.
OLLAMA_TEMPERATURE=0.7

# (optional) System prompt.
OLLAMA_SYSTEM_PROMPT=You are S.T.A.R.L.I.N.G. (Speech‑Triggered Autonomous Reasoning & Local Intelligence Node Generator), a highly capable local AI assistant. Be concise, precise, and direct. Avoid unnecessary pleasantries.


# ── FastAPI backend ───────────────────────────────────────────────────────────
# (optional) Port the uvicorn server listens on.
BACKEND_PORT=8000
# (optional) Enable uvicorn auto-reload (development only). Slows cold start.
# DEV_MODE=1
# (optional) Seconds launcher waits before printing a delayed-start warning.
# It keeps waiting in the background and auto-opens the UI once ready.
# UI_READY_TIMEOUT=120
# (optional) CORS allowed origins. "*" permits all origins (fine for local dev).
# Tighten to e.g. "http://localhost:8000" in production.
CORS_ORIGINS=*

# (optional) Documents intent for a future runtime toggle; the toolkit manifest
# is currently baked into the frontend JS constant (TOOLKIT_MANIFEST_BLOCK in
# frontend/app.js) and injected into every conversation's system prompt.
TOOLKIT_MANIFEST_ENABLED=true


# ── STT — faster-whisper ──────────────────────────────────────────────────────
# (optional) Whisper model size. Larger = more accurate, slower, more VRAM.
#   tiny | base | small | medium | large-v3
#   Recommended for most GPUs: base (fast, good accuracy)
WHISPER_MODEL_SIZE=base

# (optional) Inference device for faster-whisper / ctranslate2.
#   cuda  — NVIDIA GPU (requires CUDA 12 runtime; auto-falls back to cpu if unavailable)
#   cpu   — CPU only; slower but works everywhere
WHISPER_DEVICE=cuda


# ── TTS — Kokoro ONNX ────────────────────────────────────────────────────────
# (optional) ONNX execution provider for Kokoro TTS.
# kokoro-onnx cannot auto-detect onnxruntime-gpu (package name contains a hyphen
# which is not a valid Python identifier), so the provider must be set explicitly.
#
#   CUDAExecutionProvider    — NVIDIA GPU via CUDA 12 + cuDNN 9
#                              Requires: onnxruntime-gpu, CUDA toolkit
#   DmlExecutionProvider     — GPU via DirectX 12 (Windows only, no CUDA toolkit needed)
#                              Requires: onnxruntime-directml
#   CPUExecutionProvider     — CPU fallback; works everywhere, noticeably slower
#
ONNX_PROVIDER=CUDAExecutionProvider


# ── RAG / Document retrieval ─────────────────────────────────────────────────
# Set RAG_ENABLED=true once memory/input/ has documents, then run: make rag-ingest
# Embedding runs in-process via fastembed (ONNX) — no Ollama or extra server needed.
# Model downloads once on first ingest (~33 MB): BAAI/bge-small-en-v1.5

# (optional) Enable semantic retrieval from memory/input/ documents.
RAG_ENABLED=false

# (optional) Folder scanned for .txt and .md documents to ingest.
RAG_INPUT_FOLDER=memory/input

# (optional) On-disk path for the ChromaDB vector store.
RAG_CHROMA_PATH=memory/chroma_db

# (optional) fastembed / HuggingFace model ID used for embeddings.
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5

# (optional) Chunking parameters.
RAG_CHUNK_SIZE=200
RAG_CHUNK_OVERLAP=30

# (optional) Retrieval parameters.
RAG_TOP_K=4
RAG_VOICE_TOP_K=2
RAG_CONTEXT_WINDOW=1
RAG_MAX_CONTEXT_TOKENS=400
RAG_RERANK=false


# ── Weather — Open-Meteo (Tool 3) ─────────────────────────────────────────────
# (required) Location name as passed to the Open-Meteo geocoding API.
WEATHER_LOCATION=Framingham,Massachusetts

# (optional) Temperature units: fahrenheit | celsius
WEATHER_UNITS=fahrenheit

# (optional) How long to cache weather responses in seconds (default 10 minutes).
WEATHER_CACHE_SECONDS=600

# (optional) Path to the on-disk weather JSON cache file (relative to backend working dir).
WEATHER_CACHE_FILE=memory/weather_cache.json

# (optional) Max number of cached hourly snapshots kept per location (~1 week at hourly cadence).
WEATHER_HISTORY_MAX=168

# (optional) Human-readable label used in the panel when serving the default home location.
WEATHER_DEFAULT_LABEL=Framingham


# ── Drive Time / Commute (OpenRouteService) ─────────────────────────────────
# Supports both hosted ORS (free tier with API key) and self-hosted ORS
# (keyless Docker deployment).
#
# Hosted ORS:     https://api.openrouteservice.org   (set ORS_API_KEY)
# Self-hosted ORS: http://localhost:8082 (example)    (leave ORS_API_KEY empty)
# Self-host docs: https://giscience.github.io/openrouteservice/run-instance/

# (optional) Base URL for the ORS directions API.
ORS_BASE_URL=https://api.openrouteservice.org

# (optional) API key for hosted ORS free tier. Leave blank when self-hosting.
ORS_API_KEY=

# (optional) Default origin for commute lookups. Falls back to WEATHER_LOCATION.
DIRECTIONS_HOME=Framingham,Massachusetts

# (optional) HTTP timeout in seconds for ORS requests.
DIRECTIONS_HTTP_TIMEOUT_S=10

# (optional) In-memory cache TTL in seconds for route summaries.
DIRECTIONS_CACHE_SECONDS=600

# (optional) Apply a coarse rush-hour heuristic (typical traffic, not live traffic).
DIRECTIONS_TRAFFIC_ADJUST=true

# (optional) Multiplier applied to duration during rush windows.
DIRECTIONS_RUSH_FACTOR=1.3

# (optional) Local rush windows (HH:MM-HH:MM, comma-separated).
DIRECTIONS_RUSH_WINDOWS=07:00-09:30,16:00-18:30

# (optional) Default profile: driving-car | cycling-regular | foot-walking
DIRECTIONS_DEFAULT_PROFILE=driving-car

# (optional) Minimum destination text length accepted by the frontend parser.
DIRECTIONS_MIN_DEST_CHARS=2

# (optional) Include route geometry in /directions responses for map rendering.
DIRECTIONS_ROUTE_GEOMETRY=true

# (optional) Route animation duration in milliseconds (destination -> origin draw).
DIRECTIONS_ROUTE_ANIMATION_MS=7000

# (optional) Slow-zone threshold ratio against median route segment speed.
DIRECTIONS_SLOW_SPEED_RATIO=0.65

# (optional) Cache/schema version marker for directions payload evolution.
DIRECTIONS_SCHEMA_VERSION=2

# (optional) Map provider hint for frontend map renderer.
# Current default implementation uses a local canvas dark-grid renderer.
DIRECTIONS_MAP_PROVIDER=canvas

# (optional) Reserved for future tile-based providers.
DIRECTIONS_MAP_TILE_URL=
DIRECTIONS_MAP_ATTRIBUTION=

# (optional) Fallback to OSRM public routing when ORS is unavailable/misconfigured.
DIRECTIONS_OSRM_FALLBACK=true
DIRECTIONS_OSRM_BASE_URL=https://router.project-osrm.org


# ── News Briefing — RSS (Tool 4) ──────────────────────────────────────────────
# (optional) Default feeds used as a fallback when NEWS_FEEDS_WORLD is not set.
# Each feed contributes up to NEWS_PER_FEED headlines.
NEWS_FEEDS=https://feeds.bbci.co.uk/news/rss.xml,https://feeds.reuters.com/reuters/topNews,https://feeds.npr.org/1001/rss.xml

# (optional) Category-keyed feed lists.
# Use comma-separated RSS URLs for each category.
# When a category env var is set it overrides the built-in default for that category.
NEWS_FEEDS_WORLD=https://feeds.bbci.co.uk/news/rss.xml,https://rss.nytimes.com/services/xml/rss/nyt/World.xml,https://apnews.com/index.rss,https://feeds.reuters.com/reuters/topNews
NEWS_FEEDS_US=https://feeds.npr.org/1001/rss.xml,https://rss.nytimes.com/services/xml/rss/nyt/US.xml,https://abcnews.go.com/abcnews/topstories,https://www.cbsnews.com/latest/rss/main
NEWS_FEEDS_TECHNOLOGY=https://feeds.arstechnica.com/arstechnica/index,https://rss.nytimes.com/services/xml/rss/nyt/Technology.xml
NEWS_FEEDS_BUSINESS=https://feeds.content.dowjones.io/public/rss/RSSUSnews,https://rss.nytimes.com/services/xml/rss/nyt/Business.xml
NEWS_FEEDS_SCIENCE=https://www.sciencedaily.com/rss/all.xml,https://rss.nytimes.com/services/xml/rss/nyt/Science.xml
NEWS_FEEDS_HEALTH=https://rss.nytimes.com/services/xml/rss/nyt/Health.xml,https://feeds.npr.org/1128/rss.xml
NEWS_FEEDS_SPORTS=https://www.espn.com/espn/rss/news,https://rss.nytimes.com/services/xml/rss/nyt/Sports.xml
NEWS_FEEDS_ENTERTAINMENT=https://feeds.bbci.co.uk/news/entertainment_and_arts/rss.xml,https://rss.nytimes.com/services/xml/rss/nyt/Arts.xml

# (optional) Max headlines pulled from each individual feed.
NEWS_PER_FEED=5

# (optional) Max headlines injected into the LLM briefing context.
NEWS_LLM_LIMIT=10

# (optional) Cache duration in seconds (default 15 minutes).
NEWS_CACHE_SECONDS=900

# (optional) Enable LLM-based cross-source story synthesis.
# When true, the local LLM clusters duplicate headlines into unified story cards.
# Set to false to skip synthesis and show raw headlines (useful for debugging).
NEWS_SYNTHESIS_ENABLED=true

# (optional) Max raw headlines sent to the LLM per synthesis call.
# Larger values give better deduplication but use more context window.
NEWS_SYNTHESIS_MAX_HEADLINES=40


# ── Research Papers (arXiv / Semantic Scholar) ─────────────────────────────
# Both upstream APIs are free and require no API key.

# (optional) Default recency window: today | week | month | year | any
PAPERS_DEFAULT_SINCE=week

# (optional) Default source selection: arxiv | semanticscholar | auto
PAPERS_DEFAULT_SOURCE=auto

# (optional) Cache duration in seconds (default 30 minutes).
PAPERS_CACHE_SECONDS=1800

# (optional) HTTP timeout for outbound API calls.
PAPERS_HTTP_TIMEOUT_S=10

# (optional) Max items sent in the spoken LLM context block.
PAPERS_LLM_LIMIT=8

# (optional) Max results fetched/returned per request.
PAPERS_MAX_RESULTS=20

# (optional) Max summary length (chars) per item in LLM context.
PAPERS_SUMMARY_CHARS=240

# (optional) Minimum topic length required by frontend/backend guards.
PAPERS_MIN_TOPIC_CHARS=3

# ── Stocks & Crypto (Tool 5) ────────────────────────────────────────────────────────────
# Comma-separated Yahoo Finance ticker symbols.
# Watchlist, cache, and history are stored as JSON files (paths relative to backend/)
# Edit backend/memory/watchlist.json to change your default watchlist groups.
STOCKS_WATCHLIST_FILE=memory/watchlist.json
STOCKS_CACHE_FILE=memory/stocks_cache.json
STOCKS_HISTORY_FILE=memory/stocks_history.json

# Currency symbol displayed in the UI
STOCKS_CURRENCY_SYMBOL=$

# ── Ideas Tracker (Tool 8) ─────────────────────────────────────────────────────
# Path to the on-disk JSON array file (relative to backend working dir).
IDEAS_FILE=memory/ideas.json

# Max ideas returned by GET /ideas in a single request.
IDEAS_MAX_RETURN=100


# ── Calendar ─────────────────────────────────────────────────────────────────
# (required) Backend provider: caldav | google (google not yet implemented)
CALENDAR_BACKEND=caldav

# (required for caldav) CalDAV server URL.
# iCloud:  https://caldav.icloud.com
# Fastmail: https://caldav.fastmail.com
CALDAV_URL=https://caldav.icloud.com

# (required for caldav) CalDAV account username (usually your email address).
CALDAV_USERNAME=you@example.com

# (required for caldav) CalDAV password or app-specific password.
# iCloud requires an app-specific password: https://appleid.apple.com/account/manage
CALDAV_PASSWORD=your-app-specific-password

# (optional) IANA timezone name used when displaying and creating events.
CALENDAR_TIMEZONE=America/New_York

# (optional) How many days ahead to fetch events.
CALENDAR_LOOKAHEAD_DAYS=7

# (optional) Cache duration in seconds (default 1 hour).
CALENDAR_CACHE_SECONDS=3600

# (optional) On-disk calendar cache file path (relative to backend working dir).
CALENDAR_CACHE_FILE=memory/calendar_cache.json


# ── Long-term Memory RAG ──────────────────────────────────────────────────────
# Inject dream-state facts (extracted by pass 2) into LLM context on every query.
# Facts are stored in the starling_memory ChromaDB collection and retrieved
# via vector similarity — only the most relevant facts per query are injected.

# (optional) Enable/disable memory RAG injection globally.
MEMORY_RAG_ENABLED=true

# (optional) Facts to retrieve per query — keep low for voice latency.
MEMORY_TOP_K=3

# (optional) Word budget for the [MEMORY CONTEXT] system message block.
MEMORY_MAX_TOKENS=300
